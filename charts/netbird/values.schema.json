{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "domain",
        "trustedHTTPProxies",
        "ingress",
        "gateway",
        "serviceAccount",
        "server",
        "dashboard",
        "metrics",
        "probes",
        "postgresql",
        "bootstrap"
    ],
    "properties": {
        "nameOverride": {
            "type": "string",
            "maxLength": 63
        },
        "fullnameOverride": {
            "type": "string",
            "maxLength": 63
        },
        "commonLabels": {
            "type": "object",
            "additionalProperties": {
                "type": "string"
            }
        },
        "domain": {
            "type": "string"
        },
        "trustedHTTPProxies": {
            "type": "array",
            "items": {
                "type": "string",
                "minLength": 1
            }
        },
        "ingress": {
            "$ref": "#/definitions/ingress"
        },
        "gateway": {
            "$ref": "#/definitions/gateway"
        },
        "serviceAccount": {
            "$ref": "#/definitions/serviceAccount"
        },
        "server": {
            "$ref": "#/definitions/server"
        },
        "dashboard": {
            "$ref": "#/definitions/dashboard"
        },
        "metrics": {
            "type": "object",
            "required": [
                "enabled",
                "port"
            ],
            "properties": {
                "enabled": {
                    "type": "boolean"
                },
                "port": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 65535
                }
            },
            "additionalProperties": false
        },
        "probes": {
            "$ref": "#/definitions/probes"
        },
        "postgresql": {
            "$ref": "#/definitions/postgresql"
        },
        "bootstrap": {
            "$ref": "#/definitions/bootstrap"
        }
    },
    "allOf": [
        {
            "if": {
                "properties": {
                    "ingress": { "properties": { "enabled": { "const": true } } },
                    "gateway": { "properties": { "enabled": { "const": true } } }
                }
            },
            "then": {
                "properties": {
                    "gateway": { "properties": { "enabled": { "const": false } } }
                }
            }
        }
    ],
    "definitions": {
        "ingress": {
            "type": "object",
            "required": [
                "enabled",
                "className",
                "annotations",
                "hosts",
                "tls"
            ],
            "properties": {
                "enabled": {
                    "type": "boolean"
                },
                "className": {
                    "type": "string"
                },
                "annotations": {
                    "type": "object",
                    "additionalProperties": {
                        "type": "string"
                    }
                },
                "hosts": {
                    "type": "array",
                    "items": {
                        "type": "string",
                        "minLength": 1
                    }
                },
                "tls": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "required": [
                            "secretName",
                            "hosts"
                        ],
                        "properties": {
                            "secretName": {
                                "type": "string",
                                "minLength": 1
                            },
                            "hosts": {
                                "type": "array",
                                "items": {
                                    "type": "string",
                                    "minLength": 1
                                }
                            }
                        },
                        "additionalProperties": false
                    }
                }
            },
            "additionalProperties": false
        },
        "gateway": {
            "type": "object",
            "required": [
                "enabled",
                "parentRefs",
                "annotations"
            ],
            "properties": {
                "enabled": {
                    "type": "boolean"
                },
                "parentRefs": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "required": [
                            "name"
                        ],
                        "properties": {
                            "name": {
                                "type": "string",
                                "minLength": 1
                            },
                            "namespace": {
                                "type": "string"
                            },
                            "sectionName": {
                                "type": "string"
                            }
                        },
                        "additionalProperties": false
                    }
                },
                "annotations": {
                    "type": "object",
                    "additionalProperties": {
                        "type": "string"
                    }
                }
            },
            "allOf": [
                {
                    "if": {
                        "properties": {
                            "enabled": {
                                "const": true
                            }
                        }
                    },
                    "then": {
                        "properties": {
                            "parentRefs": {
                                "minItems": 1
                            }
                        }
                    }
                }
            ],
            "additionalProperties": false
        },
        "serviceAccount": {
            "type": "object",
            "required": [
                "create",
                "automount",
                "annotations",
                "name"
            ],
            "properties": {
                "create": {
                    "type": "boolean"
                },
                "automount": {
                    "type": "boolean"
                },
                "annotations": {
                    "type": "object",
                    "additionalProperties": {
                        "type": "string"
                    }
                },
                "name": {
                    "type": "string"
                }
            },
            "additionalProperties": false
        },
        "securityContext": {
            "type": "object",
            "properties": {
                "allowPrivilegeEscalation": {
                    "type": "boolean"
                },
                "readOnlyRootFilesystem": {
                    "type": "boolean"
                },
                "runAsNonRoot": {
                    "type": "boolean"
                },
                "capabilities": {
                    "type": "object",
                    "properties": {
                        "drop": {
                            "type": "array",
                            "items": {
                                "type": "string"
                            }
                        },
                        "add": {
                            "type": "array",
                            "items": {
                                "type": "string"
                            }
                        }
                    },
                    "additionalProperties": false
                }
            },
            "additionalProperties": true
        },
        "workloadCommon": {
            "type": "object",
            "properties": {
                "replicaCount": {
                    "type": "integer",
                    "minimum": 0
                },
                "image": {
                    "type": "object",
                    "required": [
                        "repository",
                        "pullPolicy",
                        "tag"
                    ],
                    "properties": {
                        "repository": {
                            "type": "string",
                            "minLength": 1
                        },
                        "pullPolicy": {
                            "type": "string",
                            "enum": [
                                "Always",
                                "IfNotPresent",
                                "Never"
                            ]
                        },
                        "tag": {
                            "type": "string"
                        },
                        "digest": {
                            "type": "string",
                            "pattern": "^$|^sha256:[a-f0-9]{64}$"
                        }
                    },
                    "additionalProperties": false
                },
                "extraArgs": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "podAnnotations": {
                    "type": "object",
                    "additionalProperties": {
                        "type": "string"
                    }
                },
                "podLabels": {
                    "type": "object",
                    "additionalProperties": {
                        "type": "string"
                    }
                },
                "podSecurityContext": {
                    "type": "object",
                    "additionalProperties": true
                },
                "securityContext": {
                    "$ref": "#/definitions/securityContext"
                },
                "resources": {
                    "type": "object",
                    "additionalProperties": true
                },
                "env": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "required": [
                            "name"
                        ],
                        "additionalProperties": true
                    }
                },
                "envFrom": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "additionalProperties": true
                    }
                },
                "extraVolumes": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "additionalProperties": true
                    }
                },
                "extraVolumeMounts": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "additionalProperties": true
                    }
                },
                "nodeSelector": {
                    "type": "object",
                    "additionalProperties": {
                        "type": "string"
                    }
                },
                "tolerations": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "additionalProperties": true
                    }
                },
                "affinity": {
                    "type": "object",
                    "additionalProperties": true
                }
            },
            "additionalProperties": true
        },
        "server": {
            "allOf": [
                {
                    "$ref": "#/definitions/workloadCommon"
                },
                {
                    "type": "object",
                    "required": [
                        "replicaCount",
                        "strategy",
                        "image",
                        "services",
                        "database",
                        "persistence",
                        "encryptionKey",
                        "authSecret",
                        "config",
                        "probes"
                    ],
                    "properties": {
                        "services": {
                            "type": "object",
                            "required": [
                                "http",
                                "stun"
                            ],
                            "properties": {
                                "http": {
                                    "$ref": "#/definitions/servicePort"
                                },
                                "stun": {
                                    "$ref": "#/definitions/servicePort"
                                }
                            },
                            "additionalProperties": false
                        },
                        "strategy": {
                            "$ref": "#/definitions/strategy"
                        },
                        "database": {
                            "$ref": "#/definitions/database"
                        },
                        "persistence": {
                            "$ref": "#/definitions/persistence"
                        },
                        "encryptionKey": {
                            "type": "string"
                        },
                        "authSecret": {
                            "type": "string"
                        },
                        "probes": {
                            "type": "object",
                            "required": [
                                "enabled"
                            ],
                            "properties": {
                                "enabled": {
                                    "type": "boolean"
                                }
                            },
                            "additionalProperties": false
                        },
                        "config": {
                            "type": "object",
                            "required": [
                                "existingSecret",
                                "existingSecretKey",
                                "extraYaml"
                            ],
                            "properties": {
                                "existingSecret": {
                                    "type": "string"
                                },
                                "existingSecretKey": {
                                    "type": "string",
                                    "minLength": 1
                                },
                                "extraYaml": {
                                    "type": "string"
                                }
                            },
                            "additionalProperties": false
                        }
                    },
                    "allOf": [
                        {
                            "if": {
                                "properties": {
                                    "config": {
                                        "properties": {
                                            "existingSecret": {
                                                "const": ""
                                            }
                                        }
                                    }
                                }
                            },
                            "then": {
                                "properties": {
                                    "authSecret": {
                                        "type": "string"
                                    },
                                    "encryptionKey": {
                                        "type": "string"
                                    }
                                }
                            }
                        },
                        {
                            "if": {
                                "properties": {
                                    "database": {
                                        "properties": {
                                            "mode": { "const": "sqlite" }
                                        }
                                    }
                                }
                            },
                            "then": {
                                "properties": {
                                    "replicaCount": { "const": 1 },
                                    "strategy": {
                                        "properties": {
                                            "type": { "const": "Recreate" }
                                        }
                                    }
                                }
                            }
                        }
                    ],
                    "additionalProperties": true
                }
            ]
        },
        "postgresql": {
            "type": "object",
            "required": ["enabled", "auth", "primary"],
            "properties": {
                "enabled": { "type": "boolean" },
                "auth": {
                    "type": "object",
                    "required": ["username", "database", "postgresPassword"],
                    "properties": {
                        "username": { "type": "string", "minLength": 1 },
                        "database": { "type": "string", "minLength": 1 },
                        "postgresPassword": { "type": "string" }
                    },
                    "additionalProperties": true
                },
                "primary": {
                    "type": "object",
                    "required": ["persistence"],
                    "properties": {
                        "persistence": { "type": "object", "additionalProperties": true }
                    },
                    "additionalProperties": true
                }
            },
            "additionalProperties": true
        },
        "bootstrap": {
            "type": "object",
            "required": ["enabled", "createUser", "generateAPIKey", "apiKeySecretName", "existingCredentialsSecret", "credentials", "image", "serviceAccount", "jobAnnotations", "backoffLimit", "resources"],
            "properties": {
                "enabled": { "type": "boolean" },
                "createUser": { "type": "boolean" },
                "generateAPIKey": { "type": "boolean" },
                "apiKeySecretName": { "type": "string" },
                "existingCredentialsSecret": { "type": "string" },
                "credentials": {
                    "type": "object",
                    "required": ["email", "name", "password", "emailKey", "nameKey", "passwordKey"],
                    "properties": {
                        "email": { "type": "string" },
                        "name": { "type": "string" },
                        "password": { "type": "string" },
                        "emailKey": { "type": "string", "minLength": 1 },
                        "nameKey": { "type": "string", "minLength": 1 },
                        "passwordKey": { "type": "string", "minLength": 1 }
                    },
                    "additionalProperties": false
                },
                "image": {
                    "type": "object",
                    "required": ["repository", "tag", "pullPolicy"],
                    "properties": {
                        "repository": { "type": "string", "minLength": 1 },
                        "tag": { "type": "string", "minLength": 1 },
                        "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] }
                    },
                    "additionalProperties": false
                },
                "serviceAccount": {
                    "type": "object",
                    "required": ["create", "name", "annotations"],
                    "properties": {
                        "create": { "type": "boolean" },
                        "name": { "type": "string" },
                        "annotations": { "type": "object", "additionalProperties": { "type": "string" } }
                    },
                    "additionalProperties": false
                },
                "jobAnnotations": { "type": "object", "additionalProperties": { "type": "string" } },
                "backoffLimit": { "type": "integer", "minimum": 0 },
                "resources": { "type": "object", "additionalProperties": true }
            },
            "additionalProperties": false
        },
        "strategy": {
            "type": "object",
            "required": ["type"],
            "properties": {
                "type": {
                    "type": "string",
                    "enum": ["Recreate", "RollingUpdate"]
                }
            },
            "additionalProperties": false
        },
        "database": {
            "type": "object",
            "required": ["mode", "external"],
            "properties": {
                "mode": {
                    "type": "string",
                    "enum": ["auto", "sqlite", "postgresql", "external"]
                },
                "external": {
                    "type": "object",
                    "required": ["engine", "host", "port", "name", "username", "password", "existingSecret", "existingSecretPasswordKey", "sslMode", "dsn"],
                    "properties": {
                        "engine": { "type": "string", "enum": ["postgres", "mysql"] },
                        "host": { "type": "string" },
                        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
                        "name": { "type": "string", "minLength": 1 },
                        "username": { "type": "string" },
                        "password": { "type": "string" },
                        "existingSecret": { "type": "string" },
                        "existingSecretPasswordKey": { "type": "string", "minLength": 1 },
                        "sslMode": { "type": "string", "minLength": 1 },
                        "dsn": { "type": "string" }
                    },
                    "additionalProperties": false
                }
            },
            "additionalProperties": false
        },
        "dashboard": {
            "allOf": [
                {
                    "$ref": "#/definitions/workloadCommon"
                },
                {
                    "type": "object",
                    "required": [
                        "replicaCount",
                        "image",
                        "service",
                        "probes"
                    ],
                    "properties": {
                        "service": {
                            "$ref": "#/definitions/servicePort"
                        },
                        "probes": {
                            "type": "object",
                            "required": [
                                "enabled"
                            ],
                            "properties": {
                                "enabled": {
                                    "type": "boolean"
                                }
                            },
                            "additionalProperties": false
                        }
                    },
                    "additionalProperties": true
                }
            ]
        },
        "servicePort": {
            "type": "object",
            "required": [
                "type",
                "port"
            ],
            "properties": {
                "type": {
                    "type": "string",
                    "enum": [
                        "ClusterIP",
                        "NodePort",
                        "LoadBalancer",
                        "ExternalName"
                    ]
                },
                "port": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 65535
                }
            },
            "additionalProperties": false
        },
        "persistence": {
            "type": "object",
            "required": [
                "enabled",
                "storageClass",
                "existingClaim",
                "accessModes",
                "size",
                "volumeMode",
                "annotations",
                "mountPath"
            ],
            "properties": {
                "enabled": {
                    "type": "boolean"
                },
                "storageClass": {
                    "type": "string"
                },
                "existingClaim": {
                    "type": "string"
                },
                "accessModes": {
                    "type": "array",
                    "items": {
                        "type": "string",
                        "enum": [
                            "ReadWriteOnce",
                            "ReadOnlyMany",
                            "ReadWriteMany",
                            "ReadWriteOncePod"
                        ]
                    }
                },
                "size": {
                    "type": "string",
                    "minLength": 1
                },
                "volumeMode": {
                    "type": "string",
                    "enum": [
                        "",
                        "Filesystem",
                        "Block"
                    ]
                },
                "annotations": {
                    "type": "object",
                    "additionalProperties": {
                        "type": "string"
                    }
                },
                "mountPath": {
                    "type": "string",
                    "minLength": 1
                }
            },
            "additionalProperties": true
        },
        "probeSettings": {
            "type": "object",
            "required": [
                "enabled",
                "initialDelaySeconds",
                "periodSeconds",
                "timeoutSeconds",
                "failureThreshold"
            ],
            "properties": {
                "enabled": {
                    "type": "boolean"
                },
                "initialDelaySeconds": {
                    "type": "integer",
                    "minimum": 0
                },
                "periodSeconds": {
                    "type": "integer",
                    "minimum": 1
                },
                "timeoutSeconds": {
                    "type": "integer",
                    "minimum": 1
                },
                "failureThreshold": {
                    "type": "integer",
                    "minimum": 1
                }
            },
            "additionalProperties": false
        },
        "probes": {
            "type": "object",
            "required": [
                "startup",
                "liveness",
                "readiness"
            ],
            "properties": {
                "startup": {
                    "$ref": "#/definitions/probeSettings"
                },
                "liveness": {
                    "$ref": "#/definitions/probeSettings"
                },
                "readiness": {
                    "$ref": "#/definitions/probeSettings"
                }
            },
            "additionalProperties": false
        }
    }
}
